{
  "name": "cine-gratin",
  "version": "1.0.0",
  "license": "MIT",
  "scripts": {
    "preinstall": "sh -c 'rm -f package-lock.json yarn.lock; case \"$npm_config_user_agent\" in pnpm/*) ;; *) echo \"Use pnpm instead\" >&2; exit 1 ;; esac'",
    "build": "cd frontend && pnpm build",
    "build:frontend": "cd frontend && pnpm build",
    "build:backend": "cd backend && pnpm build",
    "dev:frontend": "cd frontend && pnpm dev",
    "dev:backend": "cd backend && pnpm dev",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "render:build": "bash render-build.sh",
    "render:start": "node backend/dist/index.mjs",
    "format": "prettier --write \"frontend/src/**/*.{ts,tsx,css}\" \"backend/src/**/*.ts\" \"tests/**/*.ts\" \"scripts/**/*.mjs\" \"*.json\" \"*.md\" \".github/workflows/*.yml\"",
    "format:check": "prettier --check \"frontend/src/**/*.{ts,tsx,css}\" \"backend/src/**/*.ts\" \"tests/**/*.ts\" \"scripts/**/*.mjs\" \"*.json\" \"*.md\" \".github/workflows/*.yml\"",
    "prepare": "husky",
    "clean": "pnpm -r exec rm -rf node_modules && pnpm -r exec rm -rf dist",
    "test": "vitest run",
    "test:watch": "vitest",
    "icons": "node scripts/generate-pwa-icons.mjs",
    "lint:workflows": "node scripts/check-workflows.mjs",
    "precommit": "node scripts/pre-commit.mjs"
  },
  "private": true,
  "devDependencies": {
    "@tanstack/react-query": "^5.104.5",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/bcrypt": "^6.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.6.5",
    "@types/react": "19",
    "@types/react-dom": "19",
    "@types/supertest": "^7.2.1",
    "@types/yaml": "^1.9.7",
    "husky": "^9.1.7",
    "jsdom": "^30.1.3",
    "jsonwebtoken": "^9",
    "lucide-react": "^1.60.0",
    "prettier": "^3.8.1",
    "react": "19",
    "react-dom": "19",
    "react-router-dom": "^7.18.4",
    "sonner": "^2.0.7",
    "supertest": "^7.3.1",
    "typescript": "~5.9.2",
    "vitest": "^5.0.5",
    "yaml": "^2.9.1"
  },
  "packageManager": "pnpm@9.15.4",
  "pnpm": {
    "overrides": {
      "tar": "^7.5.22",
      "proxy-addr": "^2.0.8",
      "path-to-regexp": "^8.4.2",
      "ip-address": "^10.7.4",
      "browserslist": "^4.29.4",
      "source-map-js": "^1.2.2",
      "postcss": "^8.5.31",
      "picomatch": "^4.0.7",
      "nanoid": "^3.3.18",
      "fast-uri": "^3.1.7",
      "minimatch@3>brace-expansion": "^1.1.21",
      "minimatch@5>brace-expansion": "^2.1.6",
      "minimatch@10>brace-expansion": "^5.0.11",
      "postcss-nested>postcss-selector-parser": "^6.1.3",
      "fast-copy": "^4.1.0",
      "@babel/core": "^7.29.6",
      "esbuild": "^0.28.1"
    }
  },
  "engines": {
    "node": ">=22.19.0",
    "pnpm": ">=9"
  }
}
