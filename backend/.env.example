# ── Servidor ──────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development

# ── Base de datos ─────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/cine-gratin

# ── Autenticación del panel ───────────────────────────────────────────────────
# Secreto de firma de los tokens de sesión (mínimo 32 caracteres).
# Genera uno con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# Secreto adicional para automatizaciones por API (opcional, mínimo 16 caracteres).
# Si se define, se acepta como token Bearer de administración.
ADMIN_SECRET=

# Permite cualquier token no vacío en las rutas administrativas.
# SOLO en desarrollo y nunca en producción. Déjalo vacío o en "false".
ALLOW_INSECURE_DEV_AUTH=false

# Duración de la sesión en segundos (por defecto 8 horas).
SESSION_TTL_SECONDS=28800

# ── CORS ──────────────────────────────────────────────────────────────────────
# Orígenes permitidos, separados por coma. En producción es obligatorio.
# CORS_ORIGIN y CORS_ORIGINS son equivalentes (CORS_ORIGINS tiene prioridad).
CORS_ORIGINS=http://localhost:5173

# ── Cookie de sesión ──────────────────────────────────────────────────────────
# "lax" (mismo sitio), "strict" o "none" (requiere HTTPS y COOKIE_SECURE=true).
COOKIE_SAME_SITE=lax
COOKIE_SECURE=false

# ── Claves de terceros (opcionales) ───────────────────────────────────────────
TMDB_API_KEY=
YOUTUBE_API_KEY=

# ── Base de datos y procesos ──────────────────────────────────────────────────
DB_POOL_MAX=10
DB_POOL_MIN=0

# Límites de las operaciones por lotes.
IMPORT_BATCH_LIMIT=500
BULK_LIMIT=200

# ── Límites de peticiones ─────────────────────────────────────────────────────
RATE_LIMIT_MAX=600
LOGIN_RATE_LIMIT_MAX=10

# ── Registro ──────────────────────────────────────────────────────────────────
LOG_LEVEL=info
